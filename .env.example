# ==============================================================================
# INKSPELL PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION
# Copy this file to .env or set these variables in your deployment dashboard
# (Railway, Render, Fly.io, Vercel, or AWS). Never commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Remote MySQL or Local MySQL)
# ------------------------------------------------------------------------------
# Option A: Full Connection URL (Common on Railway, Render, Clever Cloud, Aiven)
# Example: mysql://root:password@containers-us-west-1.railway.app:7052/inkspell_db
# Or JDBC: jdbc:mysql://your-db-host.com:3306/inkspell_db?serverTimezone=UTC&sslMode=REQUIRED
DATABASE_URL=jdbc:mysql://localhost:3306/inkspell_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC

# Option B: Individual Database Parameters (fallback if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inkspell_db
DB_USER=inkspell_local
DB_PASSWORD=your_secure_db_password_here

# Setup/Migration URL (Optional: used by com.inkspell.util.DatabaseSetup; defaults to DATABASE_URL)
DB_SETUP_URL=

# ------------------------------------------------------------------------------
# 2. AI ENCHANTED LIBRARIAN ASSISTANT (Google Gemini API)
# ------------------------------------------------------------------------------
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/app/apikey
# If omitted or invalid, InkSpell smoothly falls back to its built-in offline Sanctuary Intelligence.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. NETWORKING, DOMAIN & REVERSE PROXY
# ------------------------------------------------------------------------------
# Server listening port (Automatically assigned by container hosts like Railway/Render)
PORT=8080

# Public URL of your deployed backend container (used by Vercel proxy / rewrites)
BACKEND_URL=https://your-backend-service.onrender.com

# Public URL of your Vercel deployment (used for CORS policy & secure cookie validation)
FRONTEND_URL=https://your-project.vercel.app

# ------------------------------------------------------------------------------
# 4. INITIAL ADMINISTRATOR SEEDING (Optional: com.inkspell.util.AdminSetup)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeNow123!
