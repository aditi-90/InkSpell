{
  "version": 2,
  "rewrites": [
    { "source": "/css/(.*)", "destination": "/src/main/webapp/css/$1" },
    { "source": "/js/(.*)", "destination": "/src/main/webapp/js/$1" },
    { "source": "/images/(.*)", "destination": "/src/main/webapp/images/$1" },
    { "source": "/(.*)", "destination": "/api/proxy" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
