<%@ page pageEncoding="UTF-8" %>
<%@ include file="../includes/header.jspf" %>
<section class="hero"><svg class="ghost ghost-left"><use href="#i-book"/></svg><svg class="ghost ghost-right"><use href="#i-scroll"/></svg><div class="eyebrow badge"><svg><use href="#i-star"/></svg> THE SANCTUARY OF STORIES <svg><use href="#i-star"/></svg></div><h1><span>Every story is a doorway.</span><br>Which one will you open today?</h1><p class="welcome">Welcome, traveler. The shelves have been waiting for you.</p><p class="hero-copy">Step into your own little world of stories. Discover new books, collect the ones you love,<br class="desktop"> and keep track of every journey between the pages.</p><div class="actions"><a class="button" href="${pageContext.request.contextPath}${empty sessionScope.user ? '/discover' : '/dashboard'}"><svg><use href="#i-book"/></svg>Enter the Library <span>→</span></a><a class="outline" href="#shelves">Explore the Shelves <span>↓</span></a></div><div class="hero-rule"><span>✦</span></div></section>
<div class="container"><c:if test="${not empty featured}"><section class="featured panel"><div class="featured-copy"><span class="eyebrow chosen"><svg><use href="#i-flame"/></svg><c:out value="${content.featured_badge}"/></span><p class="tiny-heading">A STORY WORTH GETTING LOST IN</p><h2><c:out value="${featured.title}"/></h2><p class="byline">By <c:out value="${featured.author}"/> · <c:out value="${featured.genre}"/></p><p class="description"><c:out value="${featured.description}"/></p><div class="actions"><button class="button" data-action="begin" data-book="${featured.id}"><svg><use href="#i-book"/></svg>Begin Reading</button><a class="outline" href="${pageContext.request.contextPath}/book?id=${featured.id}">Inspect Tome <span>→</span></a></div></div><div class="featured-art"><div class="orbit"></div><a class="featured-cover cover-link" href="${pageContext.request.contextPath}/book?id=${featured.id}"><div class="fallback-cover"><span><c:out value="${featured.title}"/></span><small><c:out value="${featured.author}"/></small></div><img class="book-cover" src="${fn:escapeXml(featured.cover_image_url)}" alt="${fn:escapeXml(featured.title)}" loading="lazy"></a><span class="tome-label">✦ FEATURED TOME ✦</span></div></section></c:if>
<section id="shelves" class="shelves-section"><div class="section-heading"><div><h2><svg><use href="#i-star"/></svg>Stories Waiting on the Shelves</h2><p>A thousand worlds. A single place to begin.</p></div><div class="arrows"><button class="icon-button" id="shelf-prev" aria-label="Previous books">←</button><button class="icon-button" id="shelf-next" aria-label="Next books">→</button></div></div><div class="shelf" id="shelf" tabindex="0" role="region" aria-label="Stories waiting on the shelves"><%@ include file="../includes/cards.jspf" %></div><div class="wood-edge"></div></section>
<section class="experience"><p class="eyebrow">YOUR OWN CHAPTER IN A WORLD OF STORIES</p><h2>A little sanctuary.<br><em>An endless adventure.</em></h2><p><c:out value="${content.intro}"/></p><div class="steps"><article><span class="step-number">I</span><svg><use href="#i-book"/></svg><h3>Shelve it.</h3><p>Find a story that calls to you. Give it a home in your private collection.</p></article><article><span class="step-number">II</span><svg><use href="#i-flame"/></svg><h3>Read it.</h3><p>Turn a few pages. Lose yourself in another world, at your own pace.</p></article><article><span class="step-number">III</span><svg><use href="#i-scroll"/></svg><h3>Chronicle it.</h3><p>Keep your progress, thoughts and favorite journeys close.</p></article></div></section>
<section class="experience-grid"><article class="panel recommendation-preview"><p class="eyebrow">A LITTLE READING MAGIC</p><svg class="large-icon"><use href="#i-star"/></svg><h2>Stories that feel<br>like they found you.</h2><p><c:out value="${content.recommendations}"/></p><a class="text-link" href="${pageContext.request.contextPath}/preferences">Find your kind of story →</a></article><article class="panel librarian-preview"><p class="eyebrow">THE ENCHANTED LIBRARIAN · PREVIEW</p><h2>A guide between the shelves.</h2><p class="chat-bubble"><c:out value="${greeting}"/></p><p class="chat-bubble visitor">Something mysterious, with a little magic.</p><a class="text-link" href="${pageContext.request.contextPath}/assistant">Ask the Librarian →</a></article></section>
<section class="testimonials"><p class="eyebrow">TRAVELER CHRONICLES</p><h2>Echoes from the Reading Desks</h2><p class="placeholder-note">Imagined reading desks · fictional placeholder entries</p><div class="testimonial-grid"><c:forEach var="t" items="${testimonials}"><article class="panel"><span class="quote-mark">“</span><blockquote><c:out value="${t.quote}"/></blockquote><div><strong><c:out value="${t.name}"/></strong><small><c:out value="${t.label}"/></small></div></article></c:forEach></div></section></div>
<%@ include file="../includes/footer.jspf" %>
