<%@ page pageEncoding="UTF-8" %>
<%@ include file="../includes/header.jspf" %>
<section class="auth-wrap"><div class="auth-ornament"><svg><use href="#i-book"/></svg></div><p class="eyebrow">YOUR SANCTUARY AWAITS</p><h1>${path == '/register' ? 'Begin your journey.' : 'Welcome back, traveler.'}</h1><p class="subtitle">${path == '/register' ? 'Every reading life begins with a single page.' : 'Step inside. Your stories are right where you left them.'}</p><form class="panel auth-form" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><c:if test="${not empty error}"><p class="alert" role="alert"><c:out value="${error}"/></p></c:if><c:if test="${path == '/register'}"><label>Full name<input name="fullName" autocomplete="name" required maxlength="100"></label></c:if><label>Email address<input type="email" name="email" autocomplete="email" required maxlength="254"></label><label>Password<input type="password" name="password" autocomplete="${path == '/register' ? 'new-password' : 'current-password'}" required minlength="8" maxlength="72"></label><c:if test="${path == '/register'}"><p class="help">At least 8 characters, including a letter and a number. Maximum 72 UTF-8 bytes.</p><label>Confirm password<input type="password" name="confirmPassword" autocomplete="new-password" required minlength="8" maxlength="72"></label></c:if><button class="button full">${path == '/register' ? 'Create my sanctuary' : 'Enter the portal'} →</button><p class="form-bottom"><c:choose><c:when test="${path == '/register'}">Already have a sanctuary? <a href="${pageContext.request.contextPath}/login">Enter the portal</a></c:when><c:otherwise>New to the library? <a href="${pageContext.request.contextPath}/register">Begin your journey</a></c:otherwise></c:choose></p></form></section>
<%@ include file="../includes/footer.jspf" %>
