<%@ page pageEncoding="UTF-8" %>
<%@ include file="../includes/header.jspf" %>
<section class="container page settings"><p class="eyebrow">THE READER BEHIND THE STORIES</p><h1>Your sanctuary.</h1><p class="subtitle">A small corner of the library that is entirely yours.</p><form class="panel" data-ajax><input type="hidden" name="action" value="profile"><h2>Reader details</h2><label>Full name<input name="fullName" value="${fn:escapeXml(sessionScope.user.full_name)}" required maxlength="100" autocomplete="name"></label><p>Email: <c:out value="${sessionScope.user.email}"/></p><p class="help">Your first chapter began on <c:out value="${sessionScope.user.created_at}"/>.</p><button class="button">Save details</button></form><form class="panel" data-ajax><input type="hidden" name="action" value="password"><h2>Change your key</h2><label>Current password<input type="password" name="currentPassword" required autocomplete="current-password" maxlength="72"></label><label>New password<input type="password" name="newPassword" required minlength="8" maxlength="72" autocomplete="new-password"></label><p class="help">At least 8 characters, including a letter and a number; maximum 72 UTF-8 bytes.</p><button class="outline">Change password</button></form><form class="panel" data-ajax data-confirm="Permanently delete your account, collection, notes, ratings, preferences and bookmarks? This cannot be undone." data-redirect="/"><input type="hidden" name="action" value="deleteAccount"><h2>Close this chapter</h2><p>Deleting your account permanently removes your private reading data.</p><label>Confirm with your password<input type="password" name="currentPassword" required autocomplete="current-password" maxlength="72"></label><button class="outline danger">Delete my account</button></form></section>
<%@ include file="../includes/footer.jspf" %>
