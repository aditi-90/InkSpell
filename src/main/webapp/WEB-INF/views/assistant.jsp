<%@ page pageEncoding="UTF-8" %>
<%@ include file="../includes/header.jspf" %>
<section class="container page"><div class="chat-room"><p class="eyebrow">A CANDLELIT CONVERSATION</p><div class="chat-title"><h1>The Enchanted Librarian</h1><button class="outline" id="new-conversation">New conversation</button></div><p class="subtitle">A little guidance between the shelves.</p><div class="panel chat-panel"><div class="chat-history" id="chat-history" role="log" aria-live="polite" aria-label="Conversation"><p class="chat-message"><c:out value="${greeting}"/></p><c:forEach var="message" items="${sessionScope.chat}"><p class="chat-message ${message.role == 'user' ? 'user' : ''}"><c:out value="${message.text}"/></p></c:forEach></div><form class="chat-form" id="chat-form"><label class="sr-only" for="message">Your message</label><input id="message" name="message" maxlength="1500" placeholder="What kind of story is calling to you?" required autocomplete="off"><button class="button">Send →</button></form></div><p class="chat-note">AI can make mistakes. Recommendations begin with our catalog. Your private notes and account details are never sent.</p></div></section>
<%@ include file="../includes/footer.jspf" %>
