<%@ page pageEncoding="UTF-8" %>
<%@ include file="../includes/header.jspf" %>
<section class="container page"><p class="eyebrow">YOUR PRIVATE SANCTUARY</p><h1>My collection.</h1><p class="subtitle">A little map of all the worlds you carry.</p><div class="tabs"><a class="${empty param.status ? 'active' : ''}" href="${pageContext.request.contextPath}/library">All stories</a><a class="${param.status == 'WANT_TO_READ' ? 'active' : ''}" href="${pageContext.request.contextPath}/library?status=WANT_TO_READ">Want to Read</a><a class="${param.status == 'CURRENTLY_READING' ? 'active' : ''}" href="${pageContext.request.contextPath}/library?status=CURRENTLY_READING">Currently Reading</a><a class="${param.status == 'COMPLETED' ? 'active' : ''}" href="${pageContext.request.contextPath}/library?status=COMPLETED">Completed</a></div><c:choose><c:when test="${empty books}"><div class="empty-state"><svg class="large-icon"><use href="#i-book"/></svg><h2>A shelf waiting for its first story.</h2><p>Find a book that calls to you and make yourself at home.</p><a class="button" href="${pageContext.request.contextPath}/discover">Find your first book →</a></div></c:when><c:otherwise><div class="book-grid"><%@ include file="../includes/cards.jspf" %></div></c:otherwise></c:choose></section>
