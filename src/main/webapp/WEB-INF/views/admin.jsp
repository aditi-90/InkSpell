<%@ page pageEncoding="UTF-8" %>
<%@ include file="../includes/header.jspf" %>
<section class="container page"><p class="eyebrow">THE HIGH LIBRARIAN'S DESK</p><h1>Tend the archive.</h1><p class="subtitle">Real stories. Your words. A sanctuary you can make your own.</p><nav class="admin-nav" aria-label="Content sections"><a class="outline" href="#books">Books &amp; featured tome</a><a class="outline" href="#content">Landing content</a><a class="outline" href="#testimonials">Testimonials</a></nav><c:if test="${not empty error}"><p class="alert" role="alert"><c:out value="${error}"/></p></c:if><c:if test="${not empty sessionScope.adminFlash}"><p class="alert"><c:out value="${sessionScope.adminFlash}"/></p><c:remove var="adminFlash" scope="session"/></c:if>
<h2 id="books">The catalog</h2><form class="filters" method="get"><input name="q" aria-label="Search catalog" maxlength="200" value="${fn:escapeXml(param.q)}" placeholder="Search titles or authors"><button class="outline">Search books</button></form><div class="admin-list"><table><thead><tr><th>Title</th><th>Author</th><th>Genre</th><th>Archive</th><th>Actions</th></tr></thead><tbody><c:forEach var="b" items="${books}"><tr><td><c:out value="${b.title}"/> ${b.is_featured ? '· Featured' : ''}</td><td><c:out value="${b.author}"/></td><td><c:out value="${b.genre}"/></td><td>${b.is_demo ? 'Demo' : 'Original'}</td><td><a href="${pageContext.request.contextPath}/admin?edit=${b.id}#book-editor">Edit</a><form class="inline-form" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${b.id}"><input type="hidden" name="action" value="feature"><button class="text-button">Feature</button></form><form class="inline-form" method="post" data-confirm-native="Delete this catalog book? Saved books cannot be deleted."><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${b.id}"><input type="hidden" name="action" value="deleteBook"><button class="text-button danger">Delete</button></form></td></tr></c:forEach></tbody></table></div>
<form class="panel admin-editor" id="book-editor" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="book"><input type="hidden" name="id" value="${editBook.id}"><h2>${empty editBook ? 'Add a new story' : 'Edit this story'}</h2><div class="form-grid"><label>Title<input name="title" required maxlength="200" value="${fn:escapeXml(editBook.title)}"></label><label>Author<input name="author" required maxlength="150" value="${fn:escapeXml(editBook.author)}"></label><label>Genre<select name="genreId" required><c:forEach var="g" items="${genres}"><option value="${g.id}" ${editBook.genre_id == g.id ? 'selected' : ''}><c:out value="${g.name}"/></option></c:forEach></select></label><label>ISBN (10 or 13 characters)<input name="isbn" maxlength="13" value="${fn:escapeXml(editBook.isbn)}"></label><label>Publication year (optional)<input name="year" type="number" min="1" max="${year+5}" value="${editBook.publication_year}"></label><label>Total pages (optional)<input name="pages" type="number" min="1" max="100000" value="${editBook.total_pages}"></label></div><label class="spaced">Cover URL (optional; HTTPS Open Library)<input type="url" name="cover" maxlength="1000" value="${fn:escapeXml(editBook.cover_image_url)}"></label><p class="help">Leave the URL empty to use the ISBN cover, or leave both empty for a leather-style generated cover.</p><label>Description<textarea name="description" required maxlength="10000"><c:out value="${editBook.description}"/></textarea></label><label class="check-label"><input type="checkbox" name="featured" ${editBook.is_featured ? 'checked' : ''}>The High Librarian's Chosen Tome</label><div class="actions"><button class="button">Save story</button><c:if test="${not empty editBook}"><a class="outline" href="${pageContext.request.contextPath}/admin#book-editor">Add a different story</a></c:if></div></form>
<h2 id="content" class="spaced">Words at the doorway</h2><c:forEach var="row" items="${contentRows}"><form class="panel admin-editor" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="content"><input type="hidden" name="key" value="${fn:escapeXml(row.key)}"><label><c:out value="${row.key}"/><textarea name="value" required maxlength="10000"><c:out value="${row.value}"/></textarea></label><button class="outline">Save words</button></form></c:forEach>
<h2 id="testimonials" class="spaced">Echoes from the reading desks</h2><p>Placeholder entries are invented. Replace or delete them before presenting them as reader feedback.</p><div class="admin-list"><table><thead><tr><th>Name</th><th>Quote</th><th>Type</th><th>Actions</th></tr></thead><tbody><c:forEach var="t" items="${testimonials}"><tr><td><c:out value="${t.name}"/></td><td><c:out value="${t.quote}"/></td><td>${t.is_placeholder ? 'Placeholder' : 'Reader entry'}</td><td><a href="${pageContext.request.contextPath}/admin?testimonial=${t.id}#testimonial-editor">Edit</a><form class="inline-form" method="post" data-confirm-native="Delete this testimonial?"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="deleteTestimonial"><input type="hidden" name="id" value="${t.id}"><button class="text-button danger">Delete</button></form></td></tr></c:forEach></tbody></table></div>
<form class="panel admin-editor" id="testimonial-editor" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="testimonial"><input type="hidden" name="id" value="${editTestimonial.id}"><h2>${empty editTestimonial ? 'Add an echo' : 'Edit this echo'}</h2><label>Quote<textarea name="quote" required maxlength="1000"><c:out value="${editTestimonial.quote}"/></textarea></label><div class="form-grid"><label>Name<input name="name" required maxlength="100" value="${fn:escapeXml(editTestimonial.name)}"></label><label>Genre or label<input name="label" required maxlength="100" value="${fn:escapeXml(editTestimonial.label)}"></label><label>Sort order<input name="sortOrder" type="number" min="0" max="10000" value="${empty editTestimonial ? 0 : editTestimonial.sort_order}" required></label><label class="check-label"><input type="checkbox" name="placeholder" ${editTestimonial.is_placeholder ? 'checked' : ''}>Invented placeholder</label></div><div class="actions"><button class="button">Save echo</button><a class="outline" href="${pageContext.request.contextPath}/admin#testimonial-editor">New entry</a></div></form></section>
<%@ include file="../includes/footer.jspf" %>
