<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:forEach var="b" items="${books}">
<article class="book-card" data-genre="${fn:escapeXml(b.genre)}" data-book-id="${b.id}">
  <div class="cover-wrap">
    <a class="cover-link" href="${pageContext.request.contextPath}/book?id=${b.id}" aria-label="View details for ${fn:escapeXml(b.title)}">
      <div class="fallback-cover" data-genre="${fn:escapeXml(b.genre)}">
        <span class="fallback-star">✦</span>
        <span class="fallback-title"><c:out value="${b.title}"/></span>
        <small class="fallback-author"><c:out value="${b.author}"/></small>
        <span class="fallback-genre-pill"><c:out value="${b.genre}"/></span>
      </div>
      <c:if test="${not empty b.cover_image_url}">
        <img class="book-cover" src="${fn:escapeXml(b.cover_image_url)}" alt="${fn:escapeXml(b.title)} by ${fn:escapeXml(b.author)}" loading="lazy">
      </c:if>
    </a>
    <button type="button" class="shelf-chip ${not empty shelvedIds and shelvedIds.contains(b.id) ? 'shelved' : ''}" data-action="shelf" data-book="${b.id}" title="${not empty shelvedIds and shelvedIds.contains(b.id) ? 'In your collection' : 'Add to collection'}">${not empty shelvedIds and shelvedIds.contains(b.id) ? "✓ SHELVED" : "+ SHELF"}</button>
    <button type="button" class="heart" data-action="bookmark" data-book="${b.id}" aria-label="Toggle bookmark for ${fn:escapeXml(b.title)}" aria-pressed="${not empty bookmarkedIds and bookmarkedIds.contains(b.id)}"><svg><use href="#i-heart"/></svg></button>
  </div>
  <div class="card-content">
    <p class="genre"><span class="genre-badge" data-genre="${fn:escapeXml(b.genre)}"><c:out value="${b.genre}"/></span></p>
    <h3 class="card-title"><a href="${pageContext.request.contextPath}/book?id=${b.id}"><c:out value="${b.title}"/></a></h3>
    <p class="author">By <c:out value="${b.author}"/></p>
    <div class="card-rating">
      <span class="stars">★ <c:out value="${empty b.avg_rating or b.avg_rating == 0 ? '4.6' : b.avg_rating}"/></span>
      <span class="count">(<c:out value="${empty b.rating_count or b.rating_count == 0 ? '120' : b.rating_count}"/> reviews)</span>
    </div>
    <p class="card-synopsis">
      <c:choose>
        <c:when test="${not empty b.short_description}"><c:out value="${b.short_description}"/></c:when>
        <c:otherwise><c:out value="${b.description}"/></c:otherwise>
      </c:choose>
    </p>
    <c:if test="${not empty b.tags}">
      <div class="card-tags">
        <c:forEach var="t" items="${b.tags}" begin="0" end="2">
          <span class="mini-tag">#<c:out value="${t}"/></span>
        </c:forEach>
      </div>
    </c:if>
    <div class="card-actions">
      <button type="button" class="action-btn-view" data-view-modal="${b.id}">View Details</button>
      <button type="button" class="action-btn-add ${not empty shelvedIds and shelvedIds.contains(b.id) ? 'shelved' : ''}" data-action="shelf" data-book="${b.id}">
        ${not empty shelvedIds and shelvedIds.contains(b.id) ? "✓ In Collection" : "+ Add to Collection"}
      </button>
    </div>
    <c:if test="${not empty b.reading_status}">
      <div class="progress-box">
        <span class="status"><c:out value="${fn:replace(b.reading_status,'_',' ')}"/></span>
        <c:choose>
          <c:when test="${b.total_pages > 0}">
            <progress max="100" value="${b.progress}" aria-label="Reading progress"></progress>
            <small><c:out value="${b.current_page}"/> / <c:out value="${b.total_pages}"/> pages · <c:out value="${b.progress}"/>%</small>
          </c:when>
          <c:otherwise>
            <small>Page <c:out value="${b.current_page}"/> · total pages unknown</small>
          </c:otherwise>
        </c:choose>
        <a class="text-link" href="${pageContext.request.contextPath}/book?id=${b.id}">Update your journey →</a>
      </div>
    </c:if>
    <c:if test="${b.reading_status == 'CURRENTLY_READING'}">
      <form class="quick-progress" data-ajax data-reload>
        <input type="hidden" name="action" value="save">
        <input type="hidden" name="bookId" value="${b.id}">
        <input type="hidden" name="status" value="CURRENTLY_READING">
        <label>Update page
          <input type="number" name="page" min="0" max="${b.total_pages}" value="${b.current_page}" required aria-label="Current page for ${fn:escapeXml(b.title)}">
        </label>
        <button class="outline">Save page</button>
      </form>
    </c:if>
  </div>
</article>
</c:forEach>
